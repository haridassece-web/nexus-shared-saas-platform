{
  "name": "nexus-shared-saas-platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api",
    "start": "npm start -w apps/api",
    "build:api": "npm run build -w apps/api",
    "start:api": "npm start -w apps/api"
  },
  "dependencies": {
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
